  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.8.3",
    "vite": "7.1.9"
  }
}
